# Подтверждение почты при регистрации
# Для разработки: SMTP_HOST=mailpit (контейнер из docker-compose, письма видны на http://localhost:8025)
# Для боевого сервера: smtp.yandex.ru / smtp.mail.ru, порт 465, SMTP_USE_SSL=true, пароль приложения
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_USE_TLS=false
MAIL_FROM=noreply@mky.local
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60